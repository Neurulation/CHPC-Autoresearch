#!/bin/sh
#PBS -N anp_spcnn_iter3b_spc_ffnn_v2_pcnn_adam
#PBS -q gpu_1
#PBS -P CSCI1166
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -o /mnt/lustre/users/aschreuder/CHPC-Autoresearch/logs/anp_spcnn_iter3b_spc_ffnn_v2_pcnn_adam.out
#PBS -e /mnt/lustre/users/aschreuder/CHPC-Autoresearch/logs/anp_spcnn_iter3b_spc_ffnn_v2_pcnn_adam.err
#PBS -m abe -M arneschreuder@icloud.com

set -euo pipefail

module purge
module load chpc/python/anaconda/3-2024.10.1

cd /mnt/lustre/users/aschreuder/CHPC-Autoresearch
source .venv/bin/activate

echo "=========================================="
echo "Job: anp_spcnn_iter3b_spc_ffnn_v2_pcnn_adam"
echo "=========================================="
echo "Start time: $(date)"
echo ""

# Re-run of iter 3 with CORRECT entry point (train_pcnn, not train).
# ce_mode='v2': SNN detached, PC energy trains self.layers, CE trains cls_head.
# True baseline for PC-trained SPC-FFNN.
python -m autoresearch.train_pcnn --multirun experiment=mnist_spc_ffnn_v2_pcnn_adam

echo ""
echo "=========================================="
echo "JOB COMPLETED"
echo "=========================================="
echo "End time: $(date)"
