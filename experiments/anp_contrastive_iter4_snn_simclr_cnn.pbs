#!/bin/sh
#PBS -N anp_contrastive_iter4_snn_simclr_cnn
#PBS -q gpu_1
#PBS -P CSCI0000
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -o /mnt/lustre/users/USERNAME/chpc_autoresearch/logs/anp_contrastive_iter4_snn_simclr_cnn.out
#PBS -e /mnt/lustre/users/USERNAME/chpc_autoresearch/logs/anp_contrastive_iter4_snn_simclr_cnn.err
#PBS -m abe -M you@example.com

set -euo pipefail

module purge
module load chpc/python/anaconda/3-2024.10.1

cd /mnt/lustre/users/USERNAME/chpc_autoresearch
source .venv/bin/activate

echo "=========================================="
echo "Job: anp_contrastive_iter4_snn_simclr_cnn"
echo "=========================================="
echo "Start time: $(date)"
echo ""

python -m autoresearch.train_contrastive --multirun experiment=mnist_snn_simclr_cnn

echo ""
echo "=========================================="
echo "JOB COMPLETED"
echo "=========================================="
echo "End time: $(date)"
