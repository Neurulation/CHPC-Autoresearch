#!/bin/sh
#PBS -N anp_snn_iter9b_snn_gru_ttfs_v2_adam
#PBS -q gpu_1
#PBS -P CSCI1166
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o /mnt/lustre/users/aschreuder/CHPC-Autoresearch/logs/anp_snn_iter9b_snn_gru_ttfs_v2_adam.out
#PBS -e /mnt/lustre/users/aschreuder/CHPC-Autoresearch/logs/anp_snn_iter9b_snn_gru_ttfs_v2_adam.err
#PBS -m abe -M arneschreuder@icloud.com

set -euo pipefail

module purge
module load chpc/python/anaconda/3-2024.10.1

cd /mnt/lustre/users/aschreuder/CHPC-Autoresearch
source .venv/bin/activate

echo "=========================================="
echo "Job: anp_snn_iter9b_snn_gru_ttfs_v2_adam"
echo "=========================================="
echo "Start time: $(date)"
echo ""

# CORRECTED re-run: threshold=0.9 (was 1.0).
# With threshold=1.0, snntorch H(mem-thr)=H(0)=0 → LIF never fired → spk_acc=0 → 11% accuracy.
# threshold=0.9: TTFS spike (amplitude=1.0) → mem=1.0 > 0.9 → LIF fires correctly.
python -m autoresearch.train --multirun experiment=mnist_snn_gru_ttfs_v2_adam

echo ""
echo "=========================================="
echo "JOB COMPLETED"
echo "=========================================="
echo "End time: $(date)"
