set -euo pipefail

module purge
module load chpc/python/anaconda/3-2024.10.1

cd /mnt/lustre/users/aschreuder/CHPC-Autoresearch
source .venv/bin/activate

echo "=========================================="
echo "Job: anp_pcnn_iter4_pc_ffnn_adam_eps"
